# ytmon secrets. Copy to .env on the deployment host, mode 600, never commit.
#
# Use a DEDICATED Google Cloud project key for the daily monitor. Sharing a key
# with the backfill or with ad-hoc queries means one can exhaust the other's
# quota, and the ledger would no longer describe what the daily run actually
# had available.
YOUTUBE_API_KEY=

# Optional: overrides for the healthcheck.
# YTMON_DB=/data/ytmon/youtube_monitoring.db
# YTMON_DATA_MOUNT=/data
